PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/loomcraft
# At least 32 random characters, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@example.com
# At least 12 characters
ADMIN_PASSWORD=replace-with-a-unique-admin-password
CLIENT_ORIGIN=http://localhost:5173
# Optional store rules (INR)
FREE_SHIPPING_THRESHOLD=1999
SHIPPING_FEE=79
