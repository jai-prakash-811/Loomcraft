{
  "name": "loomcraft",
  "version": "1.0.0",
  "private": true,
  "description": "Loomcraft: a MERN storefront for handmade Indian craft with generated block-print product art, order tracking and an admin studio.",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "nodemon --watch server server/index.js",
    "client:dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "vite": "^5.4.10"
  }
}
